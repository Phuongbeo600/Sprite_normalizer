# ========================================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL / MARIADB
# ========================================================
# Tên tài khoản người dùng kết nối cơ sở dữ liệu
SPRITE_DB_USER=sprite_app

# Mật khẩu người dùng cơ sở dữ liệu (đổi lại mật khẩu an toàn khi triển khai)
SPRITE_DB_PASSWORD=mat_khau_cua_ban_o_day

# Địa chỉ máy chủ cơ sở dữ liệu (mặc định localhost)
SPRITE_DB_HOST=127.0.0.1

# Cổng dịch vụ MySQL (mặc định 3306)
SPRITE_DB_PORT=3306

# Tên cơ sở dữ liệu lưu trữ thông tin dự án và người dùng
SPRITE_DB_NAME=sprite_normalizer

# ========================================================
# CẤU HÌNH DỊCH VỤ TRÍ TUỆ NHÂN TẠO (AI PROVIDER)
# ========================================================
# Nhà cung cấp mô hình AI mặc định ("gemini" hoặc "openai")
AI_PROVIDER=gemini

# Khoá bí mật Google Gemini API (lấy từ Google AI Studio)
GEMINI_API_KEY=khoa_api_gemini_cua_ban_o_day

# Khoá bí mật OpenAI API (nếu sử dụng OpenAI hoặc dịch vụ tương thích)
OPENAI_API_KEY=khoa_api_openai_cua_ban_o_day

# Địa chỉ máy chủ API OpenAI hoặc máy chủ cục bộ / proxy tương thích
OPENAI_BASE_URL=https://api.openai.com/v1
