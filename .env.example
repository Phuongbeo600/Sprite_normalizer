# ========================================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL / MARIADB
# ========================================================
# Tên tài khoản người dùng kết nối cơ sở dữ liệu
SPRITE_DB_USER=sprite_app

# Mật khẩu người dùng cơ sở dữ liệu (đổi lại mật khẩu an toàn khi triển khai)
SPRITE_DB_PASSWORD=mat_khau_cua_ban_o_day

# Địa chỉ máy chủ cơ sở dữ liệu (mặc định localhost)
SPRITE_DB_HOST=127.0.0.1

# Cổng dịch vụ MySQL (mặc định 3306)
SPRITE_DB_PORT=3306

# Tên cơ sở dữ liệu lưu trữ thông tin dự án và người dùng
SPRITE_DB_NAME=sprite_normalizer

# ========================================================
# CẤU HÌNH DỊCH VỤ TRÍ TUỆ NHÂN TẠO (AI PROVIDER)
# ========================================================
# Nhà cung cấp mô hình AI mặc định ("gemini" hoặc "openai")
AI_PROVIDER=gemini

# Khoá bí mật Google Gemini API (lấy từ Google AI Studio)
GEMINI_API_KEY=khoa_api_gemini_cua_ban_o_day

# Khoá bí mật OpenAI API (nếu sử dụng OpenAI hoặc dịch vụ tương thích)
OPENAI_API_KEY=khoa_api_openai_cua_ban_o_day

# Địa chỉ máy chủ API OpenAI hoặc máy chủ cục bộ / proxy tương thích
OPENAI_BASE_URL=https://api.openai.com/v1

# =========================================================================
# 1. CẤU HÌNH API CHO TRỢ LÝ HỘI THOẠI (CHATBOX)
# Sử dụng DeepSeek qua giao thức tương thích OpenAI; điền khóa DeepSeek thật.
# Cấu hình riêng ưu tiên trước dự án; giá trị trống dùng cấu hình dự phòng chung.
# =========================================================================
CHAT_AI_PROVIDER=openai
CHAT_API_KEY=sk-your-deepseek-api-key
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat

# =========================================================================
# 2. CẤU HÌNH API CHO HỒ SƠ PHÂN TÍCH NHÂN VẬT VÀ PHONG CÁCH SPRITE
# Phân tích phong cách, giải phẫu, vật liệu và ma trận 15 frame hoạt họa.
# DeepSeek nhận số đo ảnh dạng văn bản; máy chủ hỗ trợ thị giác vẫn nhận ảnh.
# Điền khóa riêng hoặc cùng khóa DeepSeek với Chatbox khi cần.
# =========================================================================
ANALYSIS_AI_PROVIDER=openai
ANALYSIS_API_KEY=sk-your-deepseek-api-key
ANALYSIS_BASE_URL=https://api.deepseek.com
ANALYSIS_MODEL=deepseek-chat

# =========================================================================
# 3. CẤU HÌNH API MẶC ĐỊNH CHO TẠO ẢNH SPRITE
# Dùng khi dự án chưa lưu key riêng; key dự án được ưu tiên hơn mặc định.
# Provider hỗ trợ: gemini hoặc openai. Dùng key có quyền tạo ảnh tương ứng.
# Để trống model để dùng mặc định của provider; có thể điền model của dịch vụ.
# Không dùng key DeepSeek của Chatbox cho API tạo ảnh Gemini hoặc OpenAI.
# =========================================================================
# openai là giao thức tương thích OpenAI Images, dùng được với dịch vụ bên thứ ba tương thích.
# Đổi dịch vụ tương thích bằng cách thay đồng thời API_KEY, BASE_URL và MODEL.
# BASE_URL là địa chỉ gốc trước /images/generations; model phải do dịch vụ đích hỗ trợ.
# Dịch vụ có giao thức riêng cần bộ kết nối riêng, không chỉ đổi tên provider.
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_MODEL=
